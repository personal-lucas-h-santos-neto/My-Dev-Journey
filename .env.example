# Configuração do LLM local (Ollama) usado pelo agente conversacional.
# Copie este arquivo para `.env` e ajuste se necessário.

# URL do servidor Ollama (padrão da instalação local)
VITE_OLLAMA_URL=http://127.0.0.1:11434

# Modelo baixado via Ollama. Use um modelo pequeno para respostas rápidas em CPU.
# "llama3.2:1b" (~1.3GB) responde em segundos; "llama2" (7B) é lento demais em CPU.
VITE_OLLAMA_MODEL=llama3.2:1b

# Número máximo de tokens gerados por resposta.
VITE_OLLAMA_MAX_TOKENS=500

# Timeout ocioso em ms: aborta se nenhum token novo chegar nesse intervalo.
VITE_OLLAMA_TIMEOUT_MS=60000
